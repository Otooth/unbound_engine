# syntax=docker/dockerfile:1.7

# The official CUDA PyTorch wheels selected by LTX's uv configuration include
# Linux aarch64 builds. The NVIDIA container runtime supplies the host driver.
FROM python:3.12-slim-bookworm@sha256:df540bfd30bd380e89a349611ce42aa67bcb542d58c047706616eb6ba2f86a1b AS source

ARG TARGETARCH
ARG LTX_COMMIT=daa6b16fc7f0f1628f2c9e36a303e3312b333cc6
ARG LTX_PIPELINES_VERSION=1.6.2
ARG UV_VERSION=0.9.18

LABEL org.opencontainers.image.source="https://github.com/Lightricks/LTX-2" \
      org.opencontainers.image.revision="${LTX_COMMIT}" \
      io.unbound.ltx-pipelines.version="${LTX_PIPELINES_VERSION}"

RUN test "${TARGETARCH}" = "arm64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}"

WORKDIR /opt/ltx

RUN git init . \
    && git remote add origin https://github.com/Lightricks/LTX-2.git \
    && git fetch --depth 1 origin "${LTX_COMMIT}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${LTX_COMMIT}"

RUN EXPECTED_VERSION="${LTX_PIPELINES_VERSION}" python - <<'PY'
import os
import pathlib
import tomllib

project = tomllib.loads(
    pathlib.Path("packages/ltx-pipelines/pyproject.toml").read_text()
)["project"]
actual = project["version"]
expected = os.environ["EXPECTED_VERSION"]
if actual != expected:
    raise SystemExit(f"ltx-pipelines version mismatch: {actual} != {expected}")
PY

FROM source AS lock

RUN uv lock

FROM scratch AS lock-export

COPY --from=lock /opt/ltx/uv.lock /uv.lock

FROM source AS runtime

# Generated once from the pinned upstream commit by
# scripts/lock-ltx-dependencies.sh. Builds never resolve moving dependencies.
COPY workers/ltx/uv.lock /opt/ltx/uv.lock
RUN uv sync --frozen --no-dev --package ltx-pipelines \
    && uv sync --frozen --no-dev --package ltx-core --extra natten --inexact

# PyTorch 2.13's Triton runtime builds its small CUDA launcher module on first
# use, so the production image needs a C compiler and libc headers.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 ltx \
    && useradd --system --uid 10001 --gid ltx \
        --home-dir /home/ltx --create-home ltx \
    && mkdir -p /opt/unbound/workers/ltx /data/input /data/output /models \
    && chown -R ltx:ltx /data /home/ltx

COPY --chown=ltx:ltx workers/ltx /opt/unbound/workers/ltx

ENV PATH="/opt/ltx/.venv/bin:${PATH}" \
    HOME="/home/ltx" \
    PYTHONPATH="/opt/unbound" \
    LTX_REPOSITORY_ROOT="/opt/ltx" \
    LTX_MODEL_ROOT="/models" \
    LTX_INPUT_ROOT="/data/input" \
    LTX_OUTPUT_ROOT="/data/output" \
    LTX_WORKER_HOST="127.0.0.1" \
    LTX_WORKER_PORT="8191" \
    LTX_OFFLOAD_MODE="cpu" \
    DO_NOT_TRACK="1" \
    HF_DATASETS_OFFLINE="1" \
    HF_HUB_DISABLE_TELEMETRY="1" \
    HF_HUB_OFFLINE="1" \
    PIP_NO_INDEX="1" \
    PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True" \
    TRANSFORMERS_OFFLINE="1" \
    UV_OFFLINE="1" \
    WANDB_MODE="offline" \
    NVIDIA_VISIBLE_DEVICES="all" \
    NVIDIA_DRIVER_CAPABILITIES="compute,utility,video"

WORKDIR /opt/unbound
USER 10001:10001

# Mount model assets read-only, for example:
#   --mount type=bind,src=/host/models,dst=/models,readonly
# With the loopback bind below, use host networking on Linux when containerized.
EXPOSE 8191

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8191/health', timeout=3)"

CMD ["python", "-m", "workers.ltx"]
